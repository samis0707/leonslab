---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isDe = lang === 'de';
---
<BaseLayout title={isDe ? 'Impressum' : 'Imprint'}>
