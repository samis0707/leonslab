  }
  .pd-workflow-cta {
    appearance: none;
    background: none;
    border: none;
    padding: 0;
    font-size: 0.83rem;
    font-weight: 500;
    color: var(--color-park-green);
    cursor: pointer;
    transition: gap 200ms ease;
  }
  .pd-workflow-cta:hover { text-decoration: underline; }

  /* FORM ---------------------------------------------------------------- */
  .pd-form-section {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    scroll-margin-top: 5rem;
  }
  .pd-form-head { margin-bottom: 1.5rem; }
  .pd-form-title {
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    font-weight: 600;
    color: var(--color-concrete-900);
    margin: 0.4rem 0 0;
    letter-spacing: -0.015em;
  }
  .pd-form {
    background: white;
    border: 1px solid var(--color-concrete-200);
    border-radius: 14px;
    padding: 1.8rem;
    box-shadow: 0 1px 2px rgba(0,0,0,0.02), 0 24px 48px -32px rgba(0,0,0,0.10);
  }
  @media (min-width: 768px) {
    .pd-form { padding: 2.2rem 2.4rem; }
  }
  .pd-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.2rem;
  }
  @media (min-width: 768px) {
    .pd-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .pd-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: var(--color-concrete-600);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
  }
  .pd-field select {
    appearance: none;
    -webkit-appearance: none;
    background: var(--color-concrete-50) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path fill='%23555' d='M0 0l5 6 5-6z'/></svg>") right 0.95rem center / 9px 6px no-repeat;
    border: 1px solid var(--color-concrete-200);
    border-radius: 8px;
    padding: 0.7rem 2.2rem 0.7rem 0.95rem;
    font-size: 0.95rem;
    color: var(--color-concrete-900);
    text-transform: none;
    letter-spacing: normal;
    font-weight: 400;
    transition: border-color 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }
  .pd-field select:focus {
    border-color: var(--color-park-green);
    background-color: white;
    outline: none;
    box-shadow: 0 0 0 3px rgba(12,94,59,0.15);
  }
  .pd-form-foot {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }
  .pd-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.6rem;
    background: var(--color-concrete-900);
    color: white;
    border: none;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 180ms ease, transform 180ms ease, opacity 180ms ease;
  }
  .pd-btn:hover { background: var(--color-park-green); transform: translateY(-1px); }
  .pd-btn:disabled { opacity: 0.55; cursor: progress; transform: none; }
  .pd-btn svg { transition: transform 180ms ease; }
  .pd-btn:hover svg { transform: translateX(2px); }

  .pd-output {
    flex: 1;
    min-width: 12rem;
    font-size: 0.85rem;
    color: var(--color-concrete-600);
  }
  .pd-output.is-error {
    padding: 0.6rem 0.95rem;
    border: 1px solid #e9c8c4;
    background: #faf1f0;
    color: #8a2a24;
    border-radius: 8px;
    font-size: 0.82rem;
  }
  .pd-output.is-loading::before {
    content: '';
    display: inline-block;
    width: 0.7rem;
    height: 0.7rem;
    border: 2px solid var(--color-concrete-200);
    border-top-color: var(--color-park-green);
    border-radius: 50%;
    margin-right: 0.55rem;
    vertical-align: -0.1em;
    animation: pd-spin 0.85s linear infinite;
  }
  @keyframes pd-spin { to { transform: rotate(360deg); } }

  /* RESULT -------------------------------------------------------------- */
  .pd-result {
    max-width: 64rem;
    margin: 3rem auto 0;
    padding: 1.8rem;
    background: white;
    border: 1px solid var(--color-concrete-200);
    border-radius: 14px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.02), 0 24px 48px -32px rgba(0,0,0,0.10);
  }
  @media (min-width: 768px) {
    .pd-result { margin-left: 1.5rem; margin-right: 1.5rem; padding: 2.2rem 2.4rem; }
  }
  .pd-result-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
