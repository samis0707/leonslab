---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="P. aeruginosa Primer Design Tool"
  description="In-Fusion primer design for three cloning applications: in-frame deletion (pEXG2), in-locus C-terminal tagging (pEXG2), constitutive expression (pBBR1MCS2)."
>
  <article class="primer-page max-w-3xl mx-auto px-6 pt-20 md:pt-28 pb-32">
    <p class="eyebrow">Tools</p>
    <h1 class="display text-[clamp(2rem,4.5vw,3.25rem)] mt-4 mb-6 text-[color:var(--color-concrete-900)]">
      P. aeruginosa Primer Design Tool
    </h1>
    <p class="text-lg text-[color:var(--color-concrete-700)] leading-relaxed mb-12 max-w-2xl">
      In-Fusion primer design for three cloning applications: in-frame deletion (pEXG2), in-locus C-terminal tagging (pEXG2), constitutive expression (pBBR1MCS2).
    </p>

    <div class="primer-notice">
      <span class="primer-notice-icon" aria-hidden="true">🚧</span>
      <span>Currently scaffolding — algorithm implementation in Phase 2</span>
    </div>
  </article>
</BaseLayout>

<style>
  .primer-notice {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1.1rem 1.4rem;
    border: 1px solid var(--color-concrete-200);
    background: white;
    border-radius: 6px;
    color: var(--color-concrete-700);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .primer-notice-icon {
    font-size: 1.05rem;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }
</style>
