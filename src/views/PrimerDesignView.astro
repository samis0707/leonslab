---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

// Build-time catalog: read data/primer_design/genes/<gene>/<isolate>.fasta
const repoRoot = path.resolve(process.cwd());
const genesDir = path.join(repoRoot, 'data', 'primer_design', 'genes');

type Catalog = Record<string, string[]>;
const catalog: Catalog = {};
if (fs.existsSync(genesDir)) {
  for (const gene of fs.readdirSync(genesDir).sort()) {
    const dir = path.join(genesDir, gene);
    if (!fs.statSync(dir).isDirectory()) continue;
    const isolates = fs
      .readdirSync(dir)
      .filter((f) => f.endsWith('.fasta'))
      .map((f) => f.replace(/\.fasta$/, ''))
      .sort();
    if (isolates.length > 0) catalog[gene] = isolates;
  }
}

const SUPPORTED_TAGS = ['FLAG', '3xFLAG', 'His6', 'His8', 'HiBiT'];
const IN_LOCUS_TAGS = ['FLAG', 'His6', 'His8'];   // ≤ 36 nt cassette
---
<BaseLayout
  title="P. aeruginosa Primer Design Tool"
  description="In-Fusion primer design for in-frame deletion (pEXG2), in-locus C-terminal tagging (pEXG2), and constitutive plasmid expression (pBBR1MCS-2)."
>
  <article class="primer-page max-w-3xl mx-auto px-6 pt-20 md:pt-28 pb-32">
    <p class="eyebrow">Tools</p>
    <h1 class="display text-[clamp(2rem,4.5vw,3.25rem)] mt-4 mb-4 text-[color:var(--color-concrete-900)]">
      P. aeruginosa Primer Design Tool
    </h1>
    <p class="text-base text-[color:var(--color-concrete-700)] leading-relaxed mb-10 max-w-2xl">
      In-Fusion primer design for three cloning workflows: in-frame deletion (pEXG2), in-locus C-terminal tagging (pEXG2), constitutive plasmid expression (pBBR1MCS-2). Choose application, gene and isolate; the tool returns the primer set, an annotated FASTA and a one-page A4 PDF.
    </p>

    <form id="pd-form" class="pd-form" autocomplete="off" novalidate
          data-catalog={JSON.stringify(catalog)}
          data-in-locus-tags={JSON.stringify(IN_LOCUS_TAGS)}
          data-all-tags={JSON.stringify(SUPPORTED_TAGS)}>
      <div class="pd-grid">
        <label class="pd-field">
          <span>Application</span>
          <select name="action" id="pd-action">
            <option value="delete">In-frame deletion (pEXG2)</option>
            <option value="tag">In-locus C-terminal tagging (pEXG2)</option>
            <option value="express">Plasmid expression (pBBR1MCS-2)</option>
          </select>
        </label>

        <label class="pd-field">
          <span>Gene</span>
          <select name="gene" id="pd-gene">
            {Object.keys(catalog).map((g) => <option value={g}>{g}</option>)}
          </select>
        </label>

        <label class="pd-field">
          <span>Isolate</span>
          <select name="isolate_id" id="pd-isolate"></select>
        </label>

        <label class="pd-field">
          <span>Enzyme</span>
          <select name="enzyme" id="pd-enzyme">
            <option value="HindIII">HindIII</option>
          </select>
        </label>

        <label class="pd-field" id="pd-tag-field" hidden>
          <span>Tag</span>
          <select name="tag" id="pd-tag">
            {SUPPORTED_TAGS.map((t) => <option value={t}>{t}</option>)}
          </select>
        </label>

        <label class="pd-field" id="pd-tag-position-field" hidden>
          <span>Tag position</span>
          <select name="tag_position" id="pd-tag-position">
            <option value="C">C-terminal</option>
            <option value="N">N-terminal</option>
          </select>
        </label>
      </div>

      <button type="submit" class="pd-btn" id="pd-submit">Design primers</button>

      <output class="pd-output" id="pd-output" aria-live="polite"></output>
    </form>

    <section class="pd-result" id="pd-result" hidden>
      <header class="pd-result-head">
        <h2 id="pd-result-title">Result</h2>
        <div class="pd-result-actions">
          <a id="pd-dl-pdf" download class="pd-link" hidden>Download PDF</a>
          <a id="pd-dl-fasta" download class="pd-link" hidden>Download FASTA</a>
          <a id="pd-dl-json" download class="pd-link" hidden>Download JSON</a>
        </div>
      </header>
      <dl class="pd-meta" id="pd-meta"></dl>
      <table class="pd-primers" id="pd-primers"><thead></thead><tbody></tbody></table>
    </section>
  </article>
</BaseLayout>

<style>
  .pd-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 38rem;
  }
  .pd-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem 1rem;
  }
  .pd-field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.82rem;
    color: var(--color-concrete-600);
  }
  .pd-field span {
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .pd-field select {
    appearance: none;
    -webkit-appearance: none;
    background: white url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path fill='%23555' d='M0 0l5 6 5-6z'/></svg>") right 0.85rem center / 9px 6px no-repeat;
    border: 1px solid var(--color-concrete-200);
    border-radius: 6px;
    padding: 0.65rem 2.1rem 0.65rem 0.85rem;
    font-size: 0.95rem;
    color: var(--color-concrete-900);
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }
  .pd-field select:focus {
    border-color: var(--color-concrete-700);
    outline: none;
    box-shadow: 0 0 0 3px var(--color-concrete-100);
  }
  .pd-btn {
    align-self: flex-start;
    padding: 0.7rem 1.4rem;
    background: var(--color-concrete-900);
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background 180ms ease, opacity 180ms ease;
  }
  .pd-btn:hover { background: black; }
  .pd-btn:disabled { opacity: 0.55; cursor: progress; }
  .pd-output {
    min-height: 1.2rem;
    font-size: 0.85rem;
    color: var(--color-concrete-600);
  }
  .pd-output.is-error {
    color: #8a2a24;
    padding: 0.6rem 0.9rem;
    border: 1px solid #e9c8c4;
    background: #faf1f0;
    border-radius: 6px;
  }
  .pd-result {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: white;
    border: 1px solid var(--color-concrete-200);
    border-radius: 8px;
  }
  .pd-result-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 1rem;
  }
  .pd-result-head h2 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-concrete-900);
    font-family: var(--font-mono);
    margin: 0;
  }
  .pd-result-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .pd-link {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-concrete-200);
    border-radius: 5px;
    font-size: 0.82rem;
    color: var(--color-concrete-800);
    text-decoration: none;
    background: var(--color-concrete-50);
    transition: background 180ms ease;
  }
  .pd-link:hover { background: var(--color-concrete-100); }
  .pd-meta {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.3rem 1rem;
    font-size: 0.85rem;
    margin: 0 0 1.2rem 0;
    color: var(--color-concrete-700);
  }
  .pd-meta dt { font-weight: 500; color: var(--color-concrete-500); }
  .pd-meta dd { margin: 0; }
  .pd-primers {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
  }
  .pd-primers th, .pd-primers td {
    padding: 0.5rem 0.6rem;
    text-align: left;
    border-bottom: 1px solid var(--color-concrete-100);
  }
  .pd-primers th {
    font-weight: 600;
    color: var(--color-concrete-700);
    background: var(--color-concrete-50);
  }
  .pd-primers td.seq {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    word-break: break-all;
  }
  .pd-primers td.seq .tail { font-weight: 700; }
</style>

<script>
  type Catalog = Record<string, string[]>;
  type ApiPrimer = {
    name: string;
    sequence: string;
    tail_len: number;
    body_len: number;
    tm_body_C: number;
    gc_body_pct: number;
  };
  type ApiResponse = {
    status: 'ok' | 'error';
    error_code?: string;
    message?: string;
    job_id?: string;
    summary?: {
      primers: ApiPrimer[];
      final_plasmid_length_bp: number;
      annealing_temp_C: number;
    };
    artefacts?: {
      fasta: string;
      pdf: string;
      json: Record<string, unknown>;
    };
    warnings?: string[];
  };

  const form = document.getElementById('pd-form') as HTMLFormElement;
  const catalog: Catalog = JSON.parse(form.dataset.catalog ?? '{}');
  const inLocusTags: string[] = JSON.parse(form.dataset.inLocusTags ?? '[]');
  const allTags: string[] = JSON.parse(form.dataset.allTags ?? '[]');

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const actionEl   = $<HTMLSelectElement>('pd-action');
  const geneEl     = $<HTMLSelectElement>('pd-gene');
  const isoEl      = $<HTMLSelectElement>('pd-isolate');
  const tagField   = $<HTMLLabelElement>('pd-tag-field');
  const tagEl      = $<HTMLSelectElement>('pd-tag');
  const tagPosField= $<HTMLLabelElement>('pd-tag-position-field');
  const tagPosEl   = $<HTMLSelectElement>('pd-tag-position');
  const submitBtn  = $<HTMLButtonElement>('pd-submit');
  const outputEl   = $<HTMLOutputElement>('pd-output');
  const resultEl   = $<HTMLElement>('pd-result');
  const titleEl    = $<HTMLElement>('pd-result-title');
  const metaEl     = $<HTMLElement>('pd-meta');
  const tableEl    = $<HTMLTableElement>('pd-primers');
  const dlPdf      = $<HTMLAnchorElement>('pd-dl-pdf');
  const dlFasta    = $<HTMLAnchorElement>('pd-dl-fasta');
  const dlJson     = $<HTMLAnchorElement>('pd-dl-json');

  // --- Cascading dropdowns -------------------------------------------------
  function refreshIsolates(): void {
    const gene = geneEl.value;
    isoEl.innerHTML = '';
    for (const id of catalog[gene] ?? []) {
      const opt = document.createElement('option');
      opt.value = id; opt.textContent = id;
      isoEl.appendChild(opt);
    }
  }
  function refreshTagFields(): void {
    const action = actionEl.value;
    if (action === 'tag') {
      tagField.hidden = false;
      tagPosField.hidden = true;             // in-locus is C-term only
      _setTagOptions(inLocusTags);
    } else if (action === 'express') {
      tagField.hidden = false;
      tagPosField.hidden = false;
      _setTagOptions(['(none)', ...allTags]);
    } else {
      tagField.hidden = true;
      tagPosField.hidden = true;
    }
  }
  function _setTagOptions(opts: string[]): void {
    const current = tagEl.value;
    tagEl.innerHTML = '';
    for (const t of opts) {
      const opt = document.createElement('option');
      opt.value = t; opt.textContent = t;
      tagEl.appendChild(opt);
    }
    if (opts.includes(current)) tagEl.value = current;
  }

  geneEl.addEventListener('change', refreshIsolates);
  actionEl.addEventListener('change', refreshTagFields);
  refreshIsolates();
  refreshTagFields();

  // --- Submit --------------------------------------------------------------
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    outputEl.classList.remove('is-error');
    outputEl.textContent = 'Designing — this can take 30 s while the genome is fetched and scanned…';
    submitBtn.disabled = true;
    resultEl.hidden = true;

    const fd = new FormData(form);
    const action = String(fd.get('action'));
    const body: Record<string, unknown> = {
      isolate_id: fd.get('isolate_id'),
      gene: fd.get('gene'),
      action,
      enzyme: fd.get('enzyme'),
      polymerase: 'B7',
    };
    if (action === 'tag') {
      body.tag = fd.get('tag');
      body.tag_position = 'C';
    } else if (action === 'express') {
      const tag = fd.get('tag');
      if (tag && tag !== '(none)') {
        body.tag = tag;
        body.tag_position = fd.get('tag_position');
      }
    }

    try {
      const resp = await fetch('/api/design', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data: ApiResponse = await resp.json();
      if (data.status !== 'ok' || !data.summary || !data.artefacts) {
        outputEl.classList.add('is-error');
        outputEl.textContent = `${data.error_code ?? 'error'}: ${data.message ?? 'unknown error'}`;
        return;
      }
      renderResult(data, body);
      outputEl.textContent = '';
    } catch (err) {
      outputEl.classList.add('is-error');
      outputEl.textContent = `Network error: ${(err as Error).message}`;
    } finally {
      submitBtn.disabled = false;
    }
  });

  function renderResult(data: ApiResponse, body: Record<string, unknown>): void {
    if (!data.summary || !data.artefacts) return;
    const constructName = projectName(body, data);
    titleEl.textContent = constructName;

    metaEl.innerHTML = '';
    const meta: [string, string][] = [
      ['Job', data.job_id ?? ''],
      ['Final plasmid', `${data.summary.final_plasmid_length_bp} bp`],
      ['Annealing Tₐ', `${data.summary.annealing_temp_C.toFixed(1)} °C (B7)`],
    ];
    if (data.warnings && data.warnings.length > 0) {
      meta.push(['Warnings', data.warnings.join('; ')]);
    }
    for (const [k, v] of meta) {
      const dt = document.createElement('dt'); dt.textContent = k;
      const dd = document.createElement('dd'); dd.textContent = v;
      metaEl.appendChild(dt); metaEl.appendChild(dd);
    }

    const thead = tableEl.querySelector('thead')!;
    const tbody = tableEl.querySelector('tbody')!;
    thead.innerHTML =
      '<tr><th>Primer</th><th>Sequence (tail bold)</th><th>nt</th><th>Tm body</th><th>GC</th></tr>';
    tbody.innerHTML = '';
    for (const p of data.summary.primers) {
      const tail = p.sequence.slice(0, p.tail_len);
      const bod = p.sequence.slice(p.tail_len);
      const tr = document.createElement('tr');
      tr.innerHTML =
        `<td>${p.name}</td>` +
        `<td class="seq"><span class="tail">${tail}</span>${bod}</td>` +
        `<td>${tail.length + bod.length}</td>` +
        `<td>${p.tm_body_C.toFixed(1)} °C</td>` +
        `<td>${p.gc_body_pct.toFixed(0)} %</td>`;
      tbody.appendChild(tr);
    }

    // Downloads
    setDownload(dlPdf, `${constructName}.pdf`, 'application/pdf', data.artefacts.pdf, true);
    setDownload(dlFasta, `${constructName}.fasta`, 'text/x-fasta', data.artefacts.fasta, true);
    const jsonStr = JSON.stringify(data.artefacts.json, null, 2);
    dlJson.href = `data:application/json;charset=utf-8,${encodeURIComponent(jsonStr)}`;
    dlJson.download = `${constructName}.json`;
    dlJson.hidden = false;

    resultEl.hidden = false;
  }

  function setDownload(a: HTMLAnchorElement, filename: string, mime: string,
                       b64: string, fromBase64: boolean): void {
    const bytes = fromBase64 ? Uint8Array.from(atob(b64), (c) => c.charCodeAt(0)) : new TextEncoder().encode(b64);
    const blob = new Blob([bytes], { type: mime });
    a.href = URL.createObjectURL(blob);
    a.download = filename;
    a.hidden = false;
  }

  function projectName(body: Record<string, unknown>, _data: ApiResponse): string {
    const action = String(body.action);
    const gene = String(body.gene);
    const iso = String(body.isolate_id);
    if (action === 'delete') return `pEXG2-Δ${gene}_${iso}`;
    if (action === 'tag')    return `pEXG2-${gene}-${body.tag}-C_${iso}`;
    const tag = body.tag ? `-${body.tag}-${body.tag_position}` : '';
    return `pBBR1MCS2-${gene}${tag}_${iso}`;
  }
</script>
