    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
  }
  .pd-hero-title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color-concrete-900);
    margin: 1.2rem 0 1.8rem;
  }
  .pd-hero-accent {
    color: var(--color-park-green);
    font-style: italic;
  }
  .pd-hero-lead {
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-concrete-700);
    max-width: 36rem;
    margin-bottom: 2.5rem;
  }
  .pd-hero-lead em {
    font-style: italic;
    color: var(--color-concrete-900);
  }

  .pd-stats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: inline-flex;
    align-items: stretch;
    gap: 1.4rem;
    padding: 0.9rem 1.4rem;
    background: white;
    border: 1px solid var(--color-concrete-200);
    border-radius: 999px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.02), 0 8px 24px -16px rgba(0,0,0,0.10);
  }
  .pd-stats li {
    display: flex;
    flex-direction: column;
    align-items: center;
