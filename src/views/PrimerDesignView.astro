  }
  .pd-stats li strong {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-concrete-900);
    letter-spacing: -0.02em;
  }
  .pd-stats li span {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-concrete-500);
    margin-top: 0.3rem;
  }
  .pd-stats-sep {
    width: 1px;
    background: var(--color-concrete-200);
    flex-shrink: 0;
  }

  /* WORKFLOW CARDS ------------------------------------------------------ */
  .pd-workflows {
    max-width: 64rem;
    margin: 0 auto 4rem;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
  }
  @media (min-width: 768px) {
    .pd-workflows { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  }
  .pd-workflow {
    position: relative;
    background: white;
    border: 1px solid var(--color-concrete-200);
    border-radius: 12px;
    padding: 1.5rem 1.4rem 1.3rem;
    transition: border-color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
  }
  .pd-workflow:hover {
    border-color: var(--color-park-green);
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -22px rgba(12,94,59,0.35);
  }
  .pd-workflow-tag {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-concrete-500);
    font-weight: 600;
    margin-bottom: 0.85rem;
  }
  .pd-workflow h3 {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-concrete-900);
    margin: 0 0 0.6rem;
    letter-spacing: -0.01em;
  }
  .pd-workflow p {
    font-size: 0.88rem;
    line-height: 1.5;
