---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

// Build-time catalog: read data/primer_design/genes/<gene>/<isolate>.fasta
const repoRoot = path.resolve(process.cwd());
const genesDir = path.join(repoRoot, 'data', 'primer_design', 'genes');

type Catalog = Record<string, string[]>;
const catalog: Catalog = {};
if (fs.existsSync(genesDir)) {
  for (const gene of fs.readdirSync(genesDir).sort()) {
    const dir = path.join(genesDir, gene);
    if (!fs.statSync(dir).isDirectory()) continue;
    const isolates = fs
      .readdirSync(dir)
      .filter((f) => f.endsWith('.fasta'))
      .map((f) => f.replace(/\.fasta$/, ''))
      .sort();
    if (isolates.length > 0) catalog[gene] = isolates;
  }
}

const SUPPORTED_TAGS = ['FLAG', '3xFLAG', 'His6', 'His8', 'HiBiT'];
const IN_LOCUS_TAGS = ['FLAG', 'His6', 'His8'];   // ≤ 36 nt cassette

// Stats for the hero strip
const allIsolates = new Set<string>();
for (const ids of Object.values(catalog)) ids.forEach((i) => allIsolates.add(i));
const stats = {
  isolates: allIsolates.size,
  genes: Object.keys(catalog).length,
  workflows: 3,
};
---
<BaseLayout
  title="AG Schwarz Primer Design"
  description="Start in a new era of experimental design with fast and easy primer development for our clinical P. aeruginosa genome databank."
>
  <!-- PASSWORD GATE ------------------------------------------------- -->
  <section class="pd-gate" id="pd-gate" aria-label="Access protected">
    <form class="pd-gate-card" id="pd-gate-form" autocomplete="off" novalidate>
      <p class="eyebrow">AG Schwarz</p>
      <h2 class="pd-gate-title">Restricted access</h2>
      <p class="pd-gate-hint">Enter the team password to continue.</p>
      <input
        type="password"
        id="pd-gate-input"
        class="pd-gate-input"
        name="password"
        placeholder="Password"
        autofocus
        spellcheck="false"
        autocomplete="off"
      />
      <button type="submit" class="pd-gate-btn">Unlock</button>
      <p class="pd-gate-error" id="pd-gate-error" hidden>Wrong password.</p>
    </form>
  </section>

  <article class="pd-page" id="pd-page" hidden>

    <!-- HERO ---------------------------------------------------------- -->
    <section class="pd-hero">
      <div class="pd-hero-inner">
        <p class="eyebrow">Tools • In-Fusion cloning</p>
        <h1 class="pd-hero-title display">
          AG Schwarz<br/>
          <span class="pd-hero-accent">Primer Design</span>
        </h1>
        <p class="pd-hero-lead">
          Start in a new era of experimental design with fast and easy primer
          development for our clinical <em>P. aeruginosa</em> genome databank.
        </p>

        <ul class="pd-stats" aria-label="Catalog">
          <li><strong>{stats.isolates}</strong><span>isolates</span></li>
          <li class="pd-stats-sep" aria-hidden="true"></li>
          <li><strong>{stats.genes}</strong><span>genes</span></li>
          <li class="pd-stats-sep" aria-hidden="true"></li>
          <li><strong>{stats.workflows}</strong><span>workflows</span></li>
        </ul>
      </div>
      <div class="pd-hero-bg" aria-hidden="true"></div>
    </section>

    <!-- WORKFLOW CARDS ------------------------------------------------- -->
    <section class="pd-workflows">
      <div class="pd-workflow" data-workflow="delete">
        <div class="pd-workflow-tag">Workflow 01</div>
        <h3>In-frame deletion</h3>
        <p>Allelic exchange via <code>pEXG2</code>. 4-primer set with 18 aa scar; sacB/GmR counterselection.</p>
        <button type="button" class="pd-workflow-cta" data-action="delete">Use this workflow →</button>
      </div>
      <div class="pd-workflow" data-workflow="tag">
        <div class="pd-workflow-tag">Workflow 02</div>
        <h3>In-locus C-term tagging</h3>
        <p>Native promoter retained. Cassette spans the junction. FLAG, His6, His8 supported.</p>
        <button type="button" class="pd-workflow-cta" data-action="tag">Use this workflow →</button>
      </div>
      <div class="pd-workflow" data-workflow="express">
        <div class="pd-workflow-tag">Workflow 03</div>
        <h3>Plasmid expression</h3>
        <p>Constitutive expression from <code>pBBR1MCS-2</code> with fixed RBS. Optional N- or C-tag.</p>
        <button type="button" class="pd-workflow-cta" data-action="express">Use this workflow →</button>
      </div>
    </section>

    <!-- FORM ----------------------------------------------------------- -->
    <section class="pd-form-section" id="pd-form-section">
      <header class="pd-form-head">
        <p class="eyebrow">Design</p>
        <h2 class="pd-form-title">Configure your primer set</h2>
      </header>

      <form id="pd-form" class="pd-form" autocomplete="off" novalidate
            data-catalog={JSON.stringify(catalog)}
            data-in-locus-tags={JSON.stringify(IN_LOCUS_TAGS)}
            data-all-tags={JSON.stringify(SUPPORTED_TAGS)}>
        <div class="pd-grid">
          <label class="pd-field">
            <span>Application</span>
            <select name="action" id="pd-action">
              <option value="delete">In-frame deletion (pEXG2)</option>
              <option value="tag">In-locus C-terminal tagging (pEXG2)</option>
              <option value="express">Plasmid expression (pBBR1MCS-2)</option>
            </select>
          </label>

          <label class="pd-field">
            <span>Gene</span>
            <select name="gene" id="pd-gene">
              {Object.keys(catalog).map((g) => <option value={g}>{g}</option>)}
            </select>
          </label>

          <label class="pd-field">
            <span>Isolate</span>
            <select name="isolate_id" id="pd-isolate"></select>
          </label>

          <label class="pd-field">
            <span>Enzyme</span>
            <select name="enzyme" id="pd-enzyme">
              <option value="HindIII">HindIII</option>
            </select>
          </label>

          <label class="pd-field" id="pd-tag-field" hidden>
            <span>Tag</span>
            <select name="tag" id="pd-tag">
              {SUPPORTED_TAGS.map((t) => <option value={t}>{t}</option>)}
            </select>
          </label>

          <label class="pd-field" id="pd-tag-position-field" hidden>
            <span>Tag position</span>
            <select name="tag_position" id="pd-tag-position">
              <option value="C">C-terminal</option>
              <option value="N">N-terminal</option>
            </select>
          </label>
        </div>

        <div class="pd-form-foot">
          <button type="submit" class="pd-btn" id="pd-submit">
            <span>Design primers</span>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <output class="pd-output" id="pd-output" aria-live="polite"></output>
        </div>
      </form>
    </section>

    <!-- RESULT --------------------------------------------------------- -->
    <section class="pd-result" id="pd-result" hidden>
      <header class="pd-result-head">
        <div>
          <p class="eyebrow">Result</p>
          <h2 id="pd-result-title">—</h2>
        </div>
        <div class="pd-result-actions">
          <a id="pd-dl-pdf" download class="pd-link pd-link-primary" hidden>Download PDF</a>
          <a id="pd-dl-fasta" download class="pd-link" hidden>FASTA</a>
          <a id="pd-dl-json" download class="pd-link" hidden>JSON</a>
        </div>
      </header>
      <dl class="pd-meta" id="pd-meta"></dl>
      <div class="pd-table-wrap">
        <table class="pd-primers" id="pd-primers"><thead></thead><tbody></tbody></table>
      </div>
    </section>

  </article>
</BaseLayout>

<style>
  /* PASSWORD GATE -------------------------------------------------- */
  .pd-gate {
