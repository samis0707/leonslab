---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Show Me Your DNA Bro" description="Interaktives Gitter-Werkzeug zum Beschriften von DNA-Sequenzen und Kanten">

<div class="gt-page" id="gt-root">

  <!-- Hero -->
  <header class="gt-hero">
    <span class="gt-hero-tag">Grid Tool</span>
    <h1 class="gt-hero-title">
      <span class="gt-hl-thin">SHOW ME YOUR</span>
      <span class="gt-hl-bold">DNA BRO</span>
    </h1>
    <p class="gt-hero-sub">Sequenzen eingeben &middot; Kanten einfärben &middot; Buchstaben setzen</p>
  </header>

  <!-- Toolbar -->
  <div class="gt-topbar">
    <button id="gt-edge-btn" type="button" class="gt-btn gt-btn-mode">Kanten auswählen</button>
    <div class="gt-col-ctrl">
      <span class="gt-col-label">Spalten</span>
      <input type="number" id="gt-col-count" class="gt-col-input" min="1" max="60" value="30">
    </div>
  </div>

  <!-- Canvas -->
  <div class="gt-canvas-outer">
    <div id="gt-canvas" class="gt-canvas"></div>
  </div>

  <!-- Actions -->
  <div class="gt-actions">
    <button id="gt-more-text"  type="button" class="gt-btn">mehr Text</button>
    <button id="gt-more-cells" type="button" class="gt-btn">mehr Kästchen</button>
  </div>

  <!-- Floating color popup -->
  <div id="gt-popup" class="gt-popup" hidden></div>

</div>

</BaseLayout>

<style>
  /* ── Page ── */
  .gt-page {
    position: relative;
    max-width: 100%;
    margin: 0 auto;
    padding: 4.5rem 2rem 5rem;
    font-family: system-ui, -apple-system, 'Helvetica Neue', sans-serif;
    color: #1a1a1a;
    min-height: 100vh;
  }

  /* ── Hero ── */
  .gt-hero {
    padding: 2.5rem 0 2.75rem;
    border-bottom: 1px solid #d4d0c8;
    margin-bottom: 2rem;
  }
  .gt-hero-tag {
    display: block;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #0c5e3b;
    margin-bottom: 1.1rem;
  }
  .gt-hero-title {
    font-size: clamp(2.8rem, 8vw, 6.5rem);
    line-height: 0.93;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0 0 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.05em;
  }
  .gt-hl-thin {
    display: block;
    font-weight: 200;
    color: #888;
    font-size: 0.72em;
    letter-spacing: 0.04em;
  }
  .gt-hl-bold {
    display: block;
    font-weight: 900;
    color: #1a1a1a;
    /* green underline accent */
    text-decoration: underline;
    text-decoration-color: #0c5e3b;
    text-decoration-thickness: 4px;
    text-underline-offset: 6px;
  }
  .gt-hero-sub {
    font-size: 0.82rem;
    color: #888;
    margin: 0;
    letter-spacing: 0.01em;
  }

  /* ── Toolbar ── */
  .gt-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid #d4d0c8;
  }

  /* ── Buttons ── */
  .gt-btn {
    padding: 0.4rem 0.9rem;
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 500;
    color: #1a1a1a;
    background: #fff;
    border: 1px solid #bbb;
    border-radius: 4px;
    cursor: pointer;
    transition: background 100ms, border-color 100ms, color 100ms;
  }
  .gt-btn:hover { background: #f4f4f2; border-color: #888; }
  .gt-btn.is-active {
    background: #e63946;
    color: #fff;
    border-color: #e63946;
  }
  .gt-btn.is-active:hover { background: #c62833; border-color: #c62833; }

  /* ── Column count ── */
  .gt-col-ctrl {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .gt-col-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #888;
  }
  .gt-col-input {
    width: 3.5rem;
    padding: 0.3rem 0.4rem;
    font-family: ui-monospace, monospace;
    font-size: 0.82rem;
    border: 1px solid #bbb;
    border-radius: 4px;
    background: #fff;
    text-align: center;
  }
  .gt-col-input:focus { outline: 2px solid #0c5e3b; outline-offset: 1px; }

  /* ── Canvas wrapper ── */
  .gt-canvas-outer {
    overflow-x: auto;
    overflow-y: visible;
    padding-bottom: 6px;
  }

  /* ── Actions ── */
  .gt-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.25rem;
    flex-wrap: wrap;
  }

  /* ── Color popup (static elements only; swatches are :global below) ── */
  .gt-popup {
    position: absolute;
    z-index: 200;
    display: flex;
    gap: 4px;
    padding: 6px 7px;
    background: #fff;
    border: 1px solid #bbb;
    border-radius: 6px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.12);
    flex-wrap: wrap;
    max-width: 220px;
  }

  /*
   * ── All elements below are created dynamically in JS and therefore
   *    MUST use :global() to escape Astro's CSS scoping. ──
   */

  /* Canvas flex column */
  :global(.gt-canvas) {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    width: max-content;
    min-width: 100%;
  }

  /* Section wrapper */
  :global(.gt-section) {
    display: flex;
    flex-direction: column;
    width: max-content;
  }

  /* Text field */
  :global(.gt-text) {
    display: block;
    height: 22px;
    padding: 2px 5px;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 11px;
    line-height: 18px;
    border: 1px solid #bbb;
    border-radius: 3px 3px 0 0;
    background: #fff;
    box-sizing: border-box;
    color: #1a1a1a;
    /* width set by JS */
  }
  :global(.gt-text:focus) {
    outline: none;
    border-color: #0c5e3b;
    background: #f0faf4;
  }

  /* Grid */
  :global(.gt-grid) {
    display: flex;
    flex-direction: column;
    position: relative;
    margin-top: -1px;   /* share border with text field */
    z-index: 1;
  }

  /* Row */
  :global(.gt-row) { display: flex; }
  :global(.gt-row:not(:first-child)) { margin-top: -1px; }

  /* Cell */
  :global(.gt-cell) {
    width: 28px;
    height: 28px;
    border: 1px solid #bbb;
    box-sizing: border-box;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    color: #1a1a1a;
    cursor: pointer;
    user-select: none;
    position: relative;
    background: #fff;
    transition: background 60ms;
  }
  :global(.gt-cell:not(:first-child)) { margin-left: -1px; }
  :global(.gt-cell:hover) { background: #f4f4f2; z-index: 1; }

  /* Selected cell */
  :global(.gt-cell.is-sel) {
    z-index: 2;
    box-shadow: inset 0 0 0 2px #0c5e3b;
    background: #f0faf4;
  }

  /* Edge mode */
  :global(.gt-canvas.gt-edge-mode .gt-cell) { cursor: crosshair; }
  :global(.gt-canvas.gt-edge-mode .gt-cell:hover) {
    background: rgba(230, 57, 70, 0.05);
  }

  /* Color swatches */
  :global(.gt-swatch) {
    width: 22px;
    height: 22px;
    border: 1px solid rgba(0,0,0,0.18);
    border-radius: 4px;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    transition: transform 80ms, box-shadow 80ms;
  }
  :global(.gt-swatch:hover) {
    transform: scale(1.18);
    box-shadow: 0 2px 6px rgba(0,0,0,0.18);
  }
</style>

<script>
(() => {
  'use strict';

  const CELL_W = 28;
  const CELL_H = 28;
  const EDGE_THRESH = 5;

  const TEXT_COLORS = [
    '#1a1a1a',
    '#e63946',
    '#fb8c00',
    '#f4c20d',
    '#43a047',
    '#1e88e5',
    '#7b1fa2',
    '#e91e63',
    '#00838f',
  ];

  /* ── State ── */
  let colCount = 30;
  let sections = [{ text: '', rowCount: 1 }];
  let letters   = {};
  let cellColors = {};
  let selected  = new Set();
  let redEdges  = new Set();
  let edgeMode  = false;
  let dragData  = null;

  /* ── DOM ── */
  const root     = document.getElementById('gt-root');
  const canvas   = document.getElementById('gt-canvas');
  const edgeBtn  = document.getElementById('gt-edge-btn');
  const colInput = document.getElementById('gt-col-count');
  const popup    = document.getElementById('gt-popup');

  /* ── Build swatches ── */
  TEXT_COLORS.forEach(c => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'gt-swatch';
    btn.style.background = c;
    btn.dataset.color = c;
    btn.title = c;
    popup.appendChild(btn);
  });

  popup.addEventListener('click', e => {
    const btn = e.target.closest('.gt-swatch');
    if (!btn) return;
    const color = btn.dataset.color;
    selected.forEach(id => {
      cellColors[id] = color;
      const el = canvas.querySelector(`[data-cid="${id}"]`);
      if (el && el.textContent) el.style.color = color;
    });
    hidePopup();
  });

  /* ── Helpers ── */
  const cid = (s, r, c) => `${s}-${r}-${c}`;
  const eid = (t, s, r, c) => `${t}-${s}-${r}-${c}`;

  /* ── Render ── */
  function fullRender() {
    canvas.innerHTML = '';
    sections.forEach((_, si) => canvas.appendChild(buildSection(si)));
  }

  function buildSection(si) {
    const sec  = sections[si];
    const wrap = document.createElement('div');
    wrap.className  = 'gt-section';
    wrap.dataset.si = si;

    const inp = document.createElement('input');
    inp.type = 'text';
    inp.className = 'gt-text';
    inp.value = sec.text;
    inp.style.width = `${colCount * CELL_W + 1}px`;
    inp.dataset.si = si;
    wrap.appendChild(inp);

    const grid = document.createElement('div');
    grid.className  = 'gt-grid';
    grid.dataset.si = si;
    for (let ri = 0; ri < sec.rowCount; ri++) {
      grid.appendChild(buildRow(si, ri));
    }
    wrap.appendChild(grid);
    return wrap;
  }

  function buildRow(si, ri) {
    const row = document.createElement('div');
    row.className  = 'gt-row';
    row.dataset.ri = ri;
    for (let ci = 0; ci < colCount; ci++) row.appendChild(buildCell(si, ri, ci));
    return row;
  }

  function buildCell(si, ri, ci) {
    const id = cid(si, ri, ci);
    const el = document.createElement('div');
    el.className   = 'gt-cell' + (selected.has(id) ? ' is-sel' : '');
    el.dataset.cid = id;
    el.dataset.si  = si;
    el.dataset.ri  = ri;
    el.dataset.ci  = ci;
    const letter = letters[id];
    if (letter) { el.textContent = letter; el.style.color = cellColors[id] || TEXT_COLORS[0]; }
    applyEdgeColors(el, si, ri, ci);
    return el;
  }

  function applyEdgeColors(el, si, ri, ci) {
    const topKey  = ri > 0 ? eid('h', si, ri - 1, ci) : null;
    el.style.borderTopColor  = topKey  && redEdges.has(topKey)  ? '#e63946' : '';
    el.style.borderTopWidth  = topKey  && redEdges.has(topKey)  ? '2px'     : '';
    const leftKey = ci > 0 ? eid('v', si, ri, ci - 1) : null;
    el.style.borderLeftColor = leftKey && redEdges.has(leftKey) ? '#e63946' : '';
    el.style.borderLeftWidth = leftKey && redEdges.has(leftKey) ? '2px'     : '';
  }

  function refreshSectionEdges(si) {
    for (let ri = 0; ri < sections[si].rowCount; ri++)
      for (let ci = 0; ci < colCount; ci++) {
        const el = canvas.querySelector(`[data-cid="${cid(si, ri, ci)}"]`);
        if (el) applyEdgeColors(el, si, ri, ci);
      }
  }

  /* ── Selection ── */
  function select(ids) {
    selected.forEach(id => canvas.querySelector(`[data-cid="${id}"]`)?.classList.remove('is-sel'));
    selected = new Set(ids);
    selected.forEach(id => canvas.querySelector(`[data-cid="${id}"]`)?.classList.add('is-sel'));
    selected.size > 0 ? showPopup() : hidePopup();
  }

  function showPopup() {
    const last = [...selected].at(-1);
    if (!last) return;
    const el = canvas.querySelector(`[data-cid="${last}"]`);
    if (!el) return;
    const cr = el.getBoundingClientRect();
    const pr = root.getBoundingClientRect();
    popup.style.left = `${cr.left - pr.left}px`;
    popup.style.top  = `${cr.bottom - pr.top + 6}px`;
    popup.hidden = false;
  }
  function hidePopup() { popup.hidden = true; }

  /* ── Pointer ── */
  canvas.addEventListener('pointerdown', e => {
    if (e.button !== 0) return;
    const cell = e.target.closest('.gt-cell');
    if (!cell) { select([]); return; }

    const si = Number(cell.dataset.si);
    const ri = Number(cell.dataset.ri);
    const ci = Number(cell.dataset.ci);

    if (edgeMode) {
      const r = cell.getBoundingClientRect();
      clickEdge(si, ri, ci, e.clientX - r.left, e.clientY - r.top, e.shiftKey);
      e.preventDefault();
      return;
    }

    dragData = { startX: e.clientX, startY: e.clientY,
                 pointerId: e.pointerId, shiftKey: e.shiftKey,
                 initSel: new Set(selected), moved: false };
    canvas.setPointerCapture(e.pointerId);
    e.preventDefault();

    if (e.shiftKey) {
      const ns = new Set(selected);
      const id = cid(si, ri, ci);
      if (ns.has(id)) ns.delete(id); else ns.add(id);
      select(ns);
    } else {
      select([cid(si, ri, ci)]);
    }
  });

  canvas.addEventListener('pointermove', e => {
    if (!dragData || !(e.buttons & 1)) return;
    if (!dragData.moved && Math.hypot(e.clientX - dragData.startX, e.clientY - dragData.startY) < 4) return;
    dragData.moved = true;
    const minX = Math.min(dragData.startX, e.clientX), maxX = Math.max(dragData.startX, e.clientX);
    const minY = Math.min(dragData.startY, e.clientY), maxY = Math.max(dragData.startY, e.clientY);
    const ns = dragData.shiftKey ? new Set(dragData.initSel) : new Set();
    canvas.querySelectorAll('.gt-cell').forEach(el => {
      const r = el.getBoundingClientRect();
      if (r.left < maxX && r.right > minX && r.top < maxY && r.bottom > minY) ns.add(el.dataset.cid);
    });
    select(ns);
  });

  canvas.addEventListener('pointerup', e => {
    if (dragData?.pointerId === e.pointerId) {
      try { canvas.releasePointerCapture(e.pointerId); } catch {}
      dragData = null;
    }
  });

  /* ── Edge click ── */
  function clickEdge(si, ri, ci, cx, cy, shift) {
    const rowCount = sections[si].rowCount;
    let key = null, minDist = Infinity;
    const checks = [
      { dist: cy,           cond: ri > 0,            k: () => eid('h', si, ri - 1, ci) },
      { dist: CELL_H - cy,  cond: ri < rowCount - 1, k: () => eid('h', si, ri, ci)     },
      { dist: cx,           cond: ci > 0,            k: () => eid('v', si, ri, ci - 1) },
      { dist: CELL_W - cx,  cond: ci < colCount - 1, k: () => eid('v', si, ri, ci)     },
    ];
    for (const ch of checks)
      if (ch.cond && ch.dist <= EDGE_THRESH && ch.dist < minDist) { minDist = ch.dist; key = ch.k(); }
    if (!key) return;
    if (!shift) {
      if (redEdges.size === 1 && redEdges.has(key)) redEdges.clear();
      else { redEdges.clear(); redEdges.add(key); }
    } else {
      if (redEdges.has(key)) redEdges.delete(key); else redEdges.add(key);
    }
    refreshSectionEdges(si);
  }

  /* ── Keyboard ── */
  document.addEventListener('keydown', e => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if (selected.size === 0) return;
    const up = e.key.toUpperCase();
    if (up.length === 1 && /^[A-Z]$/.test(up)) {
      selected.forEach(id => {
        letters[id] = up;
        const el = canvas.querySelector(`[data-cid="${id}"]`);
        if (el) { el.textContent = up; el.style.color = cellColors[id] || TEXT_COLORS[0]; }
      });
      e.preventDefault();
    } else if (e.key === 'Backspace' || e.key === 'Delete') {
      selected.forEach(id => {
        delete letters[id];
        const el = canvas.querySelector(`[data-cid="${id}"]`);
        if (el) { el.textContent = ''; el.style.color = ''; }
      });
      e.preventDefault();
    } else if (e.key === 'Escape') select([]);
  });

  /* ── Text input ── */
  canvas.addEventListener('input', e => {
    const inp = e.target.closest('.gt-text');
    if (inp) sections[Number(inp.dataset.si)].text = inp.value;
  });

  /* ── Edge mode ── */
  edgeBtn.addEventListener('click', () => {
    edgeMode = !edgeMode;
    edgeBtn.classList.toggle('is-active', edgeMode);
    canvas.classList.toggle('gt-edge-mode', edgeMode);
    if (edgeMode) select([]);
  });

  /* ── Column count ── */
  colInput.addEventListener('change', () => {
    const v = Math.max(1, Math.min(60, parseInt(colInput.value) || 30));
    colInput.value = v;
    colCount = v;
    redEdges.forEach(k => { const p = k.split('-'); if (p[0]==='v' && Number(p[3]) >= colCount-1) redEdges.delete(k); });
    selected.forEach(id => { if (Number(id.split('-')[2]) >= colCount) selected.delete(id); });
    fullRender();
  });

  /* ── Buttons ── */
  document.getElementById('gt-more-text').addEventListener('click', () => {
    sections.push({ text: '', rowCount: 1 });
    canvas.appendChild(buildSection(sections.length - 1));
  });

  document.getElementById('gt-more-cells').addEventListener('click', () => {
    const si = sections.length - 1;
    sections[si].rowCount++;
    const grid = canvas.querySelector(`.gt-grid[data-si="${si}"]`);
    if (!grid) return;
    grid.appendChild(buildRow(si, sections[si].rowCount - 1));
  });

  /* ── Dismiss popup on outside click ── */
  document.addEventListener('pointerdown', e => {
    if (popup.hidden) return;
    if (!popup.contains(e.target) && !e.target.closest('.gt-cell')) { hidePopup(); select([]); }
  }, true);

  /* ── Init ── */
  fullRender();
})();
</script>
