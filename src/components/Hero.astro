---
import fs from 'node:fs';
import path from 'node:path';
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

function imageExists(p: string): boolean {
  try {
    return fs.existsSync(path.join(process.cwd(), 'public', p.replace(/^\//, '')));
  } catch {
    return false;
  }
}

const heroImagePath = '/images/hero-concrete.jpeg';
const hasHeroImage = imageExists(heroImagePath);
---
<section class="cinematic-hero" data-hero>
  <!-- Full-bleed image -->
  <div class="hero-image" data-hero-image>
    {hasHeroImage ? (
      <img
        src={heroImagePath}
        alt="Pseudomonas Park sticker on an exposed concrete wall."
        loading="eager"
        decoding="sync"
        fetchpriority="high"
      />
    ) : (
      <div class="hero-image-placeholder"></div>
    )}
    <!-- Subtle dark gradient at the bottom for text legibility -->
    <div class="hero-gradient" aria-hidden="true"></div>
  </div>

  <!-- Editorial overlay text: title pinned to the top, supporting copy
       and CTAs anchored to the bottom so the sticker in the middle of
       the photo stays uncovered. -->
  <div class="hero-text" data-hero-text>
    <div class="hero-text-inner hero-text-top">
      <h1 class="hero-title">
        {t('hero.title.line1')}<br />{t('hero.title.line2')}
      </h1>
    </div>
    <div class="hero-text-inner hero-text-bottom">
      <p class="hero-subtitle">{t('hero.subtitle')}</p>
      <div class="hero-ctas">
        <a href={localizedPath(lang, '/cartoons/')} class="btn-primary">
          {t('hero.cta.work')}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8m0 0L7.5 3.5M11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={localizedPath(lang, '/pseudomonas-park/')} class="btn-ghost-light">
          {t('hero.cta.park')}
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll cue -->
  <div class="hero-scroll-cue" data-hero-scroll-cue aria-hidden="true">
    <span class="scroll-line"></span>
  </div>
</section>

<script>
  const hero = document.querySelector('[data-hero]');
  const header = document.querySelector('header');
  const heroImage = document.querySelector('[data-hero-image]') as HTMLElement;
  const heroText = document.querySelector('[data-hero-text]') as HTMLElement;
  const scrollCue = document.querySelector('[data-hero-scroll-cue]') as HTMLElement;

  if (hero && header && heroImage && heroText && scrollCue) {
    header.classList.add('is-on-hero');
    let ticking = false;

    function update() {
      const scrollY = window.scrollY;
      const heroHeight = (hero as HTMLElement).offsetHeight;
      const progress = Math.min(1, scrollY / heroHeight);

      // Slow parallax zoom on the image
      heroImage.style.transform = `scale(${1 + progress * 0.06})`;

      // Hero text fades out as we scroll past
      heroText.style.opacity = `${Math.max(0, 1 - progress * 1.6)}`;
      heroText.style.transform = `translateY(${progress * -32}px)`;

      // Scroll cue disappears as soon as user scrolls
      scrollCue.style.opacity = `${Math.max(0, 1 - progress * 6)}`;

      // Header switches from transparent to blurred once we've scrolled meaningfully
      if (scrollY > 80) {
        header!.classList.remove('is-on-hero');
      } else {
        header!.classList.add('is-on-hero');
      }

      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update);
  }
</script>

<style>
  /* Pull the hero up under the fixed header so it's truly full-bleed */
  .cinematic-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
    margin-top: -3.5rem;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    z-index: 1;
    will-change: transform;
    transform-origin: center;
  }
  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .hero-image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-concrete-300), var(--color-concrete-500));
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    z-index: 2;
    /* Darken both ends so the title (top) and the supporting copy +
       CTAs (bottom) stay legible. The middle stays clear so the
       sticker in the photo reads clean. */
    background:
      linear-gradient(180deg,
        rgba(13, 12, 11, 0.55) 0%,
        rgba(13, 12, 11, 0.18) 22%,
        rgba(13, 12, 11, 0) 45%,
        rgba(13, 12, 11, 0) 60%,
        rgba(13, 12, 11, 0.55) 100%);
    pointer-events: none;
  }

  .hero-text {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    /* top clearance for the fixed 3.5rem header,
       bottom clearance so the supporting copy doesn't crash into the scroll cue */
    padding-top: 6rem;
    padding-bottom: 5rem;
    will-change: transform, opacity;
    pointer-events: none;
  }
  .hero-text-inner {
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
    padding: 0 1.5rem;
    color: white;
    pointer-events: auto;
  }
  @media (min-width: 768px) {
    .hero-text {
      padding-top: 7rem;
      padding-bottom: 5.5rem;
    }
    .hero-text-inner { padding: 0 2rem; }
  }
  @media (min-width: 1024px) {
    .hero-text {
      padding-top: 8rem;
      padding-bottom: 6rem;
    }
    .hero-text-inner { padding: 0 3rem; }
  }

  .hero-eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 1.25rem;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
  }
  @media (min-width: 768px) {
    .hero-eyebrow { font-size: 0.75rem; }
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.98;
    color: white;
    font-size: clamp(2.6rem, 8.5vw, 7rem);
    margin: 0;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.32);
  }

  .hero-subtitle {
    margin: 0;
    max-width: 38rem;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.94);
    line-height: 1.55;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }
  @media (min-width: 768px) {
    .hero-subtitle { font-size: 1.1rem; }
  }

  .hero-ctas {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Light variant of btn-ghost — for use on dark/photo backgrounds */
  .btn-ghost-light {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.5rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.65);
    color: white;
    font-weight: 500;
    font-size: 0.95rem;
    transition: background 200ms ease, border-color 200ms ease, transform 200ms ease;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    background: rgba(255, 255, 255, 0.06);
  }
  .btn-ghost-light:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: white;
    transform: translateY(-1px);
  }

  .hero-scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    transform: translateX(-50%);
    z-index: 4;
    pointer-events: none;
    transition: opacity 300ms ease;
  }
  .hero-scroll-cue .scroll-line {
    display: block;
    width: 1px;
    height: 44px;
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.85) 50%, transparent);
    animation: scroll-pulse 1.8s ease-in-out infinite;
  }
  @keyframes scroll-pulse {
    0%, 100% { transform: translateY(-8px); opacity: 0.4; }
    50% { transform: translateY(8px); opacity: 1; }
  }
</style>
