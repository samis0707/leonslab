---
/**
 * Minimal petri-dish marker. Used as a quiet decorative anchor next to nav
 * items and section eyebrows. The "colonies" only fade in on hover/active
 * via the .petri-marker styles in global.css.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 14, class: cls = '' } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 14 14"
  fill="none"
  aria-hidden="true"
  class={`petri-marker ${cls}`}
>
  <circle class="dish" cx="7" cy="7" r="6.25" stroke="currentColor" stroke-width="0.75" />
  <circle class="colony" cx="5" cy="5" r="0.55" fill="currentColor" />
  <circle class="colony" cx="9" cy="6" r="0.4" fill="currentColor" />
  <circle class="colony" cx="6.2" cy="9" r="0.5" fill="currentColor" />
</svg>
