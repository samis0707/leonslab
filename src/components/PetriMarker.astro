---
/**
 * Minimal petri-dish marker. Used as a quiet decorative anchor next to nav
 * items and section eyebrows. The "colonies" only fade in on hover/active
 * via the .petri-marker styles in global.css.
 *
 * Sized so the colonies stay legible even at ~14 px in the nav bar.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 16, class: cls = '' } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 14 14"
  fill="none"
  aria-hidden="true"
  class={`petri-marker ${cls}`}
>
  <circle class="dish" cx="7" cy="7" r="6.3" stroke="currentColor" stroke-width="1" />
  <circle class="colony" cx="5" cy="5.2" r="1.35" fill="currentColor" />
  <circle class="colony" cx="9.2" cy="6.2" r="0.95" fill="currentColor" />
  <circle class="colony" cx="6.4" cy="9.4" r="1.15" fill="currentColor" />
</svg>
