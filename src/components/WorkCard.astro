---
interface Props {
  href: string;
  title: string;
  description: string;
  count?: number | string;
}
const { href, title, description, count } = Astro.props;
---
<a
  href={href}
  class="group relative flex flex-col justify-between rounded-2xl bg-white border border-[color:var(--color-concrete-200)] p-7 min-h-[260px] transition hover:border-[color:var(--color-concrete-400)] hover:-translate-y-0.5"
>
  <div class="flex items-start justify-between">
    <h3 class="display text-2xl text-[color:var(--color-concrete-900)]">{title}</h3>
    {count !== undefined && (
      <span class="text-xs font-mono text-[color:var(--color-concrete-400)]">{count}</span>
    )}
  </div>
  <p class="mt-3 text-sm text-[color:var(--color-concrete-600)] leading-relaxed">{description}</p>
  <div class="mt-6 inline-flex items-center gap-1.5 text-sm text-[color:var(--color-concrete-700)] group-hover:text-[color:var(--color-park-green)] transition-colors">
    <span>→</span>
  </div>
</a>
