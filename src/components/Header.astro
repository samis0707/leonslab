---
import { getLangFromUrl, useTranslations, getOppositeLangPath, localizedPath } from '../i18n/utils';
import PetriMarker from './PetriMarker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altLangHref = getOppositeLangPath(Astro.url);

const navItems = [
  { href: localizedPath(lang, '/cartoons/'), label: t('nav.cartoons') },
  { href: localizedPath(lang, '/stickers/'), label: t('nav.stickers') },
  { href: localizedPath(lang, '/lab-solutions/'), label: t('nav.labSolutions') },
  { href: localizedPath(lang, '/pseudomonas-park/'), label: t('nav.park') },
  { href: localizedPath(lang, '/ideas/'), label: t('nav.ideas') },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') + '/';
---
<header class="site-header fixed top-0 inset-x-0 z-50">
  <nav class="max-w-7xl mx-auto px-6 h-14 flex items-center justify-between">
    <a href={localizedPath(lang, '/')} class="hdr-logo display text-[15px] tracking-tight">
      <span class="font-bold">Leons</span><span class="hdr-logo-accent">Lab</span>
    </a>

    <ul class="hidden md:flex items-center gap-7 text-[13px]">
      {navItems.map(item => {
        const isActive = currentPath.startsWith(item.href);
        return (
          <li>
            <a
              href={item.href}
              class:list={["hdr-link group inline-flex items-center gap-1.5 transition-colors", isActive && 'is-active']}
            >
              <PetriMarker size={14} />
              <span>{item.label}</span>
            </a>
          </li>
        );
      })}
    </ul>

    <div class="flex items-center gap-4">
      <a
        href={altLangHref}
        aria-label={t('lang.switch.aria')}
        class="hdr-lang text-[11px] font-semibold tracking-[0.16em] transition-colors"
      >
        {t('lang.switch')}
      </a>

      <button
        type="button"
        aria-label="Menu"
        class="hdr-menu-btn md:hidden p-2 -m-2"
        data-mobile-menu-toggle
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <div data-mobile-menu class="hdr-mobile-menu md:hidden hidden">
    <ul class="px-6 py-4 space-y-3 text-sm">
      {navItems.map(item => (
        <li>
          <a href={item.href} class="hdr-mobile-link group inline-flex items-center gap-2">
            <PetriMarker size={16} />
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-mobile-menu-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>

<style>
  /* Default header: blurred, light bg, dark text */
  .site-header {
    background: rgba(246, 245, 242, 0.72);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(216, 214, 207, 0.6);
    transition: background 280ms ease, border-color 280ms ease, backdrop-filter 280ms ease;
  }

  .hdr-logo {
    color: var(--color-concrete-900);
    transition: color 280ms ease;
  }
  .hdr-logo-accent {
    color: var(--color-park-green);
    transition: color 280ms ease;
  }
  .hdr-link {
    color: var(--color-concrete-600);
  }
  .hdr-link:hover { color: var(--color-concrete-900); }
  .hdr-link.is-active { color: var(--color-concrete-900); }
  .hdr-lang {
    color: var(--color-concrete-500);
  }
  .hdr-lang:hover { color: var(--color-concrete-900); }
  .hdr-menu-btn { color: var(--color-concrete-700); }

  .hdr-mobile-menu {
    background: rgba(246, 245, 242, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(216, 214, 207, 0.6);
  }
  .hdr-mobile-link { color: var(--color-concrete-700); }

  /* On-hero state: transparent, light text — applied by Hero script when scrollY < ~80 */
  .site-header.is-on-hero {
    background: transparent;
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    border-bottom-color: transparent;
  }
  .site-header.is-on-hero .hdr-logo {
    color: rgba(255, 255, 255, 0.98);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.32);
  }
  .site-header.is-on-hero .hdr-logo-accent {
    /* Slightly muted green over photo so the logo reads as a unit */
    color: rgba(255, 255, 255, 0.98);
  }
  .site-header.is-on-hero .hdr-link {
    color: rgba(255, 255, 255, 0.78);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.32);
  }
  .site-header.is-on-hero .hdr-link:hover,
  .site-header.is-on-hero .hdr-link.is-active {
    color: white;
  }
  .site-header.is-on-hero .hdr-lang {
    color: rgba(255, 255, 255, 0.78);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.32);
  }
  .site-header.is-on-hero .hdr-lang:hover { color: white; }
  .site-header.is-on-hero .hdr-menu-btn {
    color: rgba(255, 255, 255, 0.95);
  }
</style>
