---
import { getLangFromUrl, useTranslations, getOppositeLangPath, localizedPath } from '../i18n/utils';
import PetriMarker from './PetriMarker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altLangHref = getOppositeLangPath(Astro.url);

const navItems = [
  { href: localizedPath(lang, '/cartoons/'), label: t('nav.cartoons') },
  { href: localizedPath(lang, '/stickers/'), label: t('nav.stickers') },
  { href: localizedPath(lang, '/lab-solutions/'), label: t('nav.labSolutions') },
  { href: localizedPath(lang, '/pseudomonas-park/'), label: t('nav.park') },
  { href: localizedPath(lang, '/ideas/'), label: t('nav.ideas') },
  { href: localizedPath(lang, '/primer-design/'), label: t('nav.primerDesign') },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') + '/';
---
<header class="site-header fixed top-0 inset-x-0 z-50">
  <nav class="max-w-7xl mx-auto px-6 h-14 flex items-center justify-between">
    <a href={localizedPath(lang, '/')} class="hdr-logo display text-[15px] tracking-tight">
      <span class="font-bold">Leons</span><span class="hdr-logo-accent text-[color:var(--color-park-green)]">Lab</span>
    </a>

    <ul class="hidden md:flex items-center gap-7 text-[13px]">
      {navItems.map(item => {
        const isActive = currentPath.startsWith(item.href);
        return (
          <li>
            <a
              href={item.href}
              class:list={["hdr-link group inline-flex items-center gap-1.5 transition-colors", isActive && 'is-active']}
            >
              <PetriMarker size={14} />
              <span>{item.label}</span>
            </a>
          </li>
        );
      })}
    </ul>

    <div class="flex items-center gap-4">
      <a
        href={altLangHref}
        aria-label={t('lang.switch.aria')}
        class="hdr-lang text-[11px] font-semibold tracking-[0.16em] transition-colors"
      >
        {t('lang.switch')}
      </a>

      <button
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        class="hdr-menu-btn md:hidden p-2 -m-2"
        data-mobile-menu-toggle
      >
        <svg class="hdr-icon hdr-icon-open" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
        </svg>
        <svg class="hdr-icon hdr-icon-close" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M3.5 3.5l11 11M14.5 3.5l-11 11" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <div data-mobile-menu class="hdr-mobile-menu md:hidden">
    <div class="hdr-mobile-menu-inner">
      <ul>
        {navItems.map(item => (
          <li>
            <a href={item.href} class="hdr-mobile-link">
              <PetriMarker size={14} />
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header') as HTMLElement | null;
  const toggle = document.querySelector('[data-mobile-menu-toggle]') as HTMLButtonElement | null;
  const menu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
  const menuInner = document.querySelector('.hdr-mobile-menu-inner') as HTMLElement | null;
  const root = document.documentElement;

  function setMenuOffset() {
    if (!menuInner) return;
    const h = menuInner.scrollHeight;
    root.style.setProperty('--menu-offset', `${h}px`);
  }

  if (header && toggle && menu && menuInner) {
    setMenuOffset();
    window.addEventListener('resize', setMenuOffset);

    toggle.addEventListener('click', () => {
      const opening = !header.classList.contains('is-menu-open');
      setMenuOffset();
      header.classList.toggle('is-menu-open', opening);
      document.body.classList.toggle('is-menu-open', opening);
      toggle.setAttribute('aria-expanded', opening ? 'true' : 'false');

      // While the drawer is open, force the standard (blurred-light) header
      // appearance — drop the on-hero transparent state so the menu reads as
      // a solid panel even when the user is at the top of the landing page.
      if (opening) {
        header.classList.remove('is-on-hero');
      } else if (window.scrollY < 80 && document.querySelector('[data-hero]')) {
        header.classList.add('is-on-hero');
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('is-menu-open')) {
        toggle.click();
      }
    });
  }
</script>

<style>
  /* Default header: blurred, light bg, dark text */
  .site-header {
    background: rgba(246, 245, 242, 0.72);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(216, 214, 207, 0.6);
    transition: background 280ms ease, border-color 280ms ease, backdrop-filter 280ms ease;
  }

  .hdr-logo {
    color: var(--color-concrete-900);
    transition: color 280ms ease;
  }
  .hdr-logo-accent {
    transition: color 280ms ease;
  }
  .hdr-link {
    color: var(--color-concrete-600);
  }
  .hdr-link:hover { color: var(--color-concrete-900); }
  .hdr-link.is-active { color: var(--color-concrete-900); }
  .hdr-lang {
    color: var(--color-concrete-500);
  }
  .hdr-lang:hover { color: var(--color-concrete-900); }
  .hdr-menu-btn {
    color: var(--color-concrete-700);
    position: relative;
    width: 1.125rem;
    height: 1.125rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .hdr-icon {
    position: absolute;
    inset: 0;
    margin: auto;
    transition: opacity 220ms ease, transform 220ms ease;
  }
  .hdr-icon-open { opacity: 1; transform: rotate(0deg); }
  .hdr-icon-close { opacity: 0; transform: rotate(-45deg); }
  .site-header.is-menu-open .hdr-icon-open { opacity: 0; transform: rotate(45deg); }
  .site-header.is-menu-open .hdr-icon-close { opacity: 1; transform: rotate(0deg); }

  /* Mobile drawer that pushes the page down. Solid bg, slides via
     grid-template-rows trick. Sits below the 3.5rem header bar. */
  .hdr-mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-concrete-50);
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 360ms cubic-bezier(0.2, 0.8, 0.2, 1);
    overflow: hidden;
    pointer-events: none;
  }
  .hdr-mobile-menu-inner {
    min-height: 0;
    overflow: hidden;
    /* The hairline lives on the inner element so overflow:hidden clips it
       while the drawer is collapsed (grid-template-rows: 0fr). */
    border-bottom: 1px solid var(--color-concrete-200);
  }
  .site-header.is-menu-open .hdr-mobile-menu {
    grid-template-rows: 1fr;
    pointer-events: auto;
  }

  .hdr-mobile-menu-inner ul {
    list-style: none;
    margin: 0;
    padding: 0.85rem 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
  }
  .hdr-mobile-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-concrete-800);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    padding: 0.45rem 0;
    transition: color 200ms ease;
  }
  .hdr-mobile-link:hover {
    color: var(--color-park-green);
  }

  /* On-hero state: transparent, light text — applied by Hero script when scrollY < ~80
     and removed while the menu drawer is open. */
  .site-header.is-on-hero {
    background: transparent;
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    border-bottom-color: transparent;
  }
  .site-header.is-on-hero .hdr-logo {
    color: rgba(255, 255, 255, 0.98);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.32);
  }
  header.site-header.is-on-hero .hdr-logo-accent {
    color: rgba(255, 255, 255, 0.98);
  }
  .site-header.is-on-hero .hdr-link {
    color: rgba(255, 255, 255, 0.78);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.32);
  }
  .site-header.is-on-hero .hdr-link:hover,
  .site-header.is-on-hero .hdr-link.is-active {
    color: white;
  }
  .site-header.is-on-hero .hdr-lang {
    color: rgba(255, 255, 255, 0.78);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.32);
  }
  .site-header.is-on-hero .hdr-lang:hover { color: white; }
  .site-header.is-on-hero .hdr-menu-btn {
    color: rgba(255, 255, 255, 0.95);
  }
</style>
