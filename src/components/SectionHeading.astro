---
import PetriMarker from './PetriMarker.astro';
interface Props {
  eyebrow?: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---
<header class="flex flex-col gap-3 max-w-3xl">
  {eyebrow && (
    <p class="eyebrow inline-flex items-center gap-2 text-[color:var(--color-concrete-500)]">
      <span class="is-active inline-flex"><PetriMarker size={12} /></span>
      <span>{eyebrow}</span>
    </p>
  )}
  <h2 class="display text-[clamp(1.75rem,4vw,3rem)] text-[color:var(--color-concrete-900)]">{title}</h2>
</header>
